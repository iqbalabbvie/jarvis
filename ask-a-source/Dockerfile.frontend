# Stage 1: Build React frontend
FROM node:18 AS build

WORKDIR /app
COPY chat-bot-ui/package*.json ./chat-bot-ui/
WORKDIR /app/chat-bot-ui
RUN npm install
COPY chat-bot-ui/ ./
RUN npm run build

# Stage 2: Serve frontend with Nginx
FROM nginx:alpine
COPY --from=build /app/chat-bot-ui/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
